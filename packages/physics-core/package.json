{
  "name": "@gamekits/physics-core",
  "version": "0.1.0-alpha.8",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-library-package.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/physics-core/test --passWithNoTests",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@gamekits/core": "workspace:*",
    "@gamekits/data": "workspace:*",
    "@gamekits/game-runtime": "workspace:*",
    "@gamekits/save": "workspace:*",
    "@gamekits/world": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "gamekitsBuild": {
    "bundleDts": false,
    "entries": [
      "src/index.ts",
      "src/testing/index.ts"
    ]
  }
}
