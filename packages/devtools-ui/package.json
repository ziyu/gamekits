{
  "name": "@gamekits/devtools-ui",
  "version": "0.1.0-alpha.8",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-library-package.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/devtools-ui/test --passWithNoTests",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@gamekits/devtools": "workspace:*",
    "@gamekits/react-ui": "workspace:*",
    "@gamekits/ui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "gamekitsBuild": {
    "copy": [
      {
        "from": "src/styles.css",
        "to": "dist/styles.css"
      }
    ]
  }
}
